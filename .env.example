# ============================================================================
#  ENVIRONMENT — copy this file to `.env.local` and fill in what you need
# ============================================================================
#  Nothing here is required to run the project. With no Supabase credentials
#  the site runs in demo mode: the public pages render from `src/content/*`
#  and appointment requests are written to a local store in `.data/`
#  (git-ignored). The moment the Supabase values are present, the real
#  integrations activate.
#
#  `.env.local` is git-ignored and must never be committed. This template is
#  committed so every environment is configured the same way.
#  See README → §2 "Quick start" and §9 "Deployment hardening".
# ============================================================================

# ── Supabase — appointments, messages, staff, opening hours ─────────────────
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"

# Server-only. It bypasses Row Level Security, so it must never reach the
# browser: no `NEXT_PUBLIC_` prefix, and never expose it in client code.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# ── Site URL ────────────────────────────────────────────────────────────────
# Absolute address used for canonical links and in notification emails.
# Leave unset locally; set it to the live domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Appointment notifications ───────────────────────────────────────────────
# Address that receives new appointment requests. Without it (and without a
# mail provider below) notifications are written to the server log instead.
CLINIC_NOTIFICATION_EMAIL=""

# ── Outbound email (optional) ───────────────────────────────────────────────
# With no provider configured, confirmations are logged server-side and the
# clinic is notified through the admin dashboard.
RESEND_API_KEY=""
EMAIL_FROM=""

# ── Admin dashboard ─────────────────────────────────────────────────────────
# Development-only convenience: opens a demo dashboard when Supabase is not
# configured. It has no real authentication — never enable it on a deployment
# holding patient data, and keep it "false" in production.
ADMIN_DEMO_ACCESS="false"

# Signs the demo session cookie (HMAC). Any long random string, for example
# `openssl rand -base64 32`. Required whenever ADMIN_DEMO_ACCESS is enabled.
SESSION_SECRET=""
